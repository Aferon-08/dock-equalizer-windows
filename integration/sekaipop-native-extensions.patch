--- a/docs/PLUGINS.md
+++ b/docs/PLUGINS.md
@@ -433,3 +433,18 @@
 sh sekaipop/tests/plugin-test/plugin_state_test.sh     # the state script, against a throwaway folder
 node sekaipop/tests/preset-widgets-test/registry_unit.js
 ```
+
+
+## Proposed native extension surfaces (additive API 1)
+
+`extensions: ["dock", "wallpaper", "settings"]` declares optional surfaces, implemented by fixed entry files `Dock.qml`, `Wallpaper.qml`, `Settings.qml`. The manager only clones/links the repository. No install hooks run. One dock/wallpaper provider is selected deterministically by plugin id; conflicting providers must not be installed together in this initial proposal.
+
+The service host advertises `capabilities`: `native-dock-v1`, `native-wallpaper-v1`, `native-settings-v1`, `transient-palette-v1`, `native-media-v1`, `native-dock-input-v1`. Services may implement `extensionEnabled(slot)` to switch off a surface without changing shell files.
+
+Dock host: base widget settings/service/theme plus the live dock item, geometry, media source, lyrics, hover/edit/desktop-empty state and monitor palette. Dock entry outputs `fits`, `ownsHousing`, `widthExtra`, `heightExtra`, `headerHeight`, `iconsOffset`, `iconsOpacity`, `iconsScale`, `suppressMediaKey`. Wallpaper host: theme/settings/service, screenName, configured widget rectangles, barEdge/barExtent, working and setSetting. Settings host: state/theme, opened, close(), screenName, native phone capture item/rect and viewport rect. Settings entry exposes `showing` while its exit animation completes.
+
+With `native-dock-input-v1`, `host.dock.appInteraction` means the stock app row, its drag or a dock card is receiving input. An entry may implement `handlesDockPoint(item, point)` for its own controls. The stock hit area yields those points before a press and retains its existing grab after a press. An entry may expose `holdingDockPointer` during a gesture and `wantsDockKeyboard` for its focused or hovered control. The dock uses on-demand keyboard interactivity and releases it when the control clears the request.
+
+Theme IPC exposes renewable palette leases (`musicSet`, `musicClear`, `musicStatus`) with baseline restoration and expiry. Persistent theme settings are not the music override. Existing desktop/bar plugins are unchanged.
+
+This section documents a proposal; upstream review and version assignment are required before advertising support in the reviewed catalogue.
diff --git a/sekaipop/modules/common/functions/ExtensionProviders.js b/sekaipop/modules/common/functions/ExtensionProviders.js
new file mode 100644
--- /dev/null
+++ b/sekaipop/modules/common/functions/ExtensionProviders.js
@@ -0,0 +1,19 @@
+.pragma library
+
+// Deterministic selection. A preference is retained while a plugin is disabled,
+// and the returned reason makes the temporary fallback explicit to the user.
+function resolve(slot, candidates, preferred) {
+    if (!["dock", "wallpaper", "settings"].includes(slot))
+        return {selected:"", preferred:"", state:"unsupported", candidates:[], message:"Unknown extension slot"}
+    const ordered = candidates.slice().sort((a,b)=>a.id < b.id ? -1 : a.id > b.id ? 1 : 0)
+    const ready = ordered.filter(c=>c.ready && c.enabled)
+    const chosen = ready.find(c=>c.id===preferred) || ready[0]
+    const selected = chosen ? chosen.id : ""
+    const requested = preferred || ""
+    const state = requested && requested!==selected ? "preferred-unavailable"
+        : !selected ? "unavailable" : requested ? "selected" : ready.length>1 ? "conflict" : "automatic"
+    const message = state==="preferred-unavailable" ? "Preferred plugin is unavailable; using " + (selected || "the shell default")
+        : state==="conflict" ? "Several plugins request this surface. Automatic choice: " + selected + ". Choose a provider below."
+        : selected ? "Active provider: " + selected : "No enabled provider; using the shell default"
+    return {selected, preferred:requested, state, candidates:ordered, message}
+}
